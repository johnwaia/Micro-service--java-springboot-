                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function localIso(d) {",
                  "  const p = n => String(n).padStart(2, '0');",
                  "  return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + 'T' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':00';",
                  "}",
                  "pm.collectionVariables.set('classDate', localIso(new Date(Date.now() + 3 * 3600 * 1000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
