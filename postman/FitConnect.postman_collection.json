            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Boxe imminente\",\n  \"description\": \"Cours cree par la collection Postman\",\n  \"instructor\": \"Marie Dupont\",\n  \"gymLocation\": \"Paris - Bastille\",\n  \"category\": \"BOXING\",\n  \"level\": \"BEGINNER\",\n  \"durationMinutes\": 45,\n  \"maxParticipants\": 10,\n  \"price\": 20,\n  \"dateTime\": \"{{classDate}}\"\n}",
              "options": {
