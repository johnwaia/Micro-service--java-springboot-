        {
          "name": "Paiement expire -> 409 (profil demo)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bookings/{{expiringBookingId}}/confirm",
