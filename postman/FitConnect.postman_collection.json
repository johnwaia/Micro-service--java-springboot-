              ],
              "path": [
                "api",
                "bookings",
                "{{expiringBookingId}}",
                "confirm"
              ]
            },
            "description": "Necessite booking-service lance avec le profil demo (payment-timeout = 20 s). Le pre-request script attend 25 s.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"CREDIT_CARD\",\n  \"cardLastFour\": \"1234\",\n  \"transactionId\": \"txn_123456\"\n}",
              "options": {
