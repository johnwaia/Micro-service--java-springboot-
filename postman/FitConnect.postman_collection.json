                "classes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Spinning 5 places\",\n  \"description\": \"Cours cree par la collection Postman\",\n  \"instructor\": \"Marie Dupont\",\n  \"gymLocation\": \"Paris - Bastille\",\n  \"category\": \"SPINNING\",\n  \"level\": \"BEGINNER\",\n  \"durationMinutes\": 45,\n  \"maxParticipants\": 5,\n  \"price\": 12,\n  \"dateTime\": \"{{classDate}}\"\n}",
              "options": {
