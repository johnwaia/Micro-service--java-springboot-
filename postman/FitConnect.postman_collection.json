              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// attend que paymentDeadline (bookingDate + 20 s en profil demo) soit depasse",
                  "setTimeout(() => {}, 25000);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 409', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "[prep] Cours dans 3 heures",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
