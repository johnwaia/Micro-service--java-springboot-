{
  "info": {
    "name": "FitConnect - Reservation de cours de sport",
    "description": "Collection du TP Efrei M2-DEV2 Microservices (class-service, booking-service, payment-service, notification-service).\n\nToutes les requetes passent par l'api-gateway ({{baseUrl}} = http://localhost:8090).\nExecuter les dossiers dans l'ordre (Collection Runner) : les ids crees sont chaines via les variables de collection.\n\nLe scenario \"Paiement expire\" attend 25 s : il faut lancer booking-service avec le profil demo\n(payment-timeout = 20 s), sinon le delai de paiement est de 1 h et la requete renverra 200.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8090"
    },
    {
      "key": "classDate",
      "value": ""
    },
    {
      "key": "classId",
      "value": ""
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "smallClassId",
      "value": ""
    },
    {
      "key": "expiringBookingId",
      "value": ""
    },
    {
      "key": "soonClassId",
      "value": ""
    },
    {
      "key": "lateBookingId",
      "value": ""
    },
    {
      "key": "expensiveClassId",
      "value": ""
    },
    {
      "key": "expensiveBookingId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Gestion des cours",
      "item": [
        {
          "name": "Creer un cours",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/classes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "classes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Yoga Vinyasa Postman\",\n  \"description\": \"Cours cree par la collection Postman\",\n  \"instructor\": \"Marie Dupont\",\n  \"gymLocation\": \"Paris - Bastille\",\n  \"category\": \"YOGA\",\n  \"level\": \"INTERMEDIATE\",\n  \"durationMinutes\": 60,\n  \"maxParticipants\": 10,\n  \"price\": 25,\n  \"dateTime\": \"{{classDate}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "function localIso(d) {",
                  "  const p = n => String(n).padStart(2, '0');",
                  "  return d.getFullYear() + '-' + p(d.getMonth() + 1) + '-' + p(d.getDate()) + 'T' + p(d.getHours()) + ':' + p(d.getMinutes()) + ':00';",
                  "}",
                  "pm.collectionVariables.set('classDate', localIso(new Date(Date.now() + 168 * 3600 * 1000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const c = pm.response.json();",
                  "pm.collectionVariables.set('classId', c.id);",
                  "pm.test('SCHEDULED, 0 participant', () => { pm.expect(c.status).to.eql('SCHEDULED'); pm.expect(c.currentParticipants).to.eql(0); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Lister les cours (pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes?page=0&size=10&sort=dateTime,asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "classes"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "dateTime,asc"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('page', () => pm.expect(pm.response.json().content).to.be.an('array'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filtrer YOGA / INTERMEDIATE",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes?category=YOGA&level=INTERMEDIATE",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "classes"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "YOGA"
                },
                {
                  "key": "level",
                  "value": "INTERMEDIATE"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('uniquement YOGA INTERMEDIATE', () => pm.response.json().content.forEach(c => { pm.expect(c.category).to.eql('YOGA'); pm.expect(c.level).to.eql('INTERMEDIATE'); }));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechercher (lieu + coach + dates)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes/search?location=Paris&instructor=Marie",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "classes",
                "search"
              ],
              "query": [
                {
                  "key": "location",
                  "value": "Paris"
                },
                {
                  "key": "instructor",
                  "value": "Marie"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Details d'un cours",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/classes/{{classId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "classes",
                "{{classId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('bon cours', () => pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('classId'))));"
                ]
              }
            }
          ]
        }
      ]
    },
