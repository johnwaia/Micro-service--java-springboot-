                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set('bookingId', b.id);",
                  "pm.test('PENDING_PAYMENT', () => pm.expect(b.status).to.eql('PENDING_PAYMENT'));",
                  "pm.test('reference BK-XXXXX', () => pm.expect(b.bookingReference).to.match(/^BK-[A-Z0-9]{5}$/));",
                  "pm.test('totalAmount = 2 x 25', () => pm.expect(Number(b.totalAmount)).to.eql(50));"
                ]
              }
